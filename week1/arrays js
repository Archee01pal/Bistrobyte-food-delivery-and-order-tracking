//arrays creation and indexing
let marks=[34,87,94,78];
console.log(marks);
marks[1]=90;
console.log(marks);

//push,pop,concat,shift,unshift,       push adds t item to the end of the string
let veggies=['tomato','onion','carrot'];
console.log(veggies);
veggies.push("chips");
console.log(veggies);

//pop
veggies.pop();
console.log(veggies);

//concat(to add two strings or arrays together)
let veggies=['tomato','onion','carrot'];
let fruits=["apple","banana","mango"];
let eating=veggies.concat(fruits);
console.log(eating);

//unshift, adds the item to the front of the string, like push but at the front
veggies.unshift("potato");
console.log(veggies);

//shift, deletes the first item of the array, like pop but at the front
veggies.shift();
console.log(veggies);

//find, finds the item in the array or list
let arr=[1,2,3,4,5];
let found=arr.find(el=el%2==0);
console.log(found);

//filter, filters the array based on the condition
let arr=[1,2,3,4,5];
let filtered=arr.filter(el=el%2==0);
console.log(filtered);

//slice, acts like a slice of cake, it takes a part between two items in an array
let marks=[23,45,67,82,93,12];
let markks=marks.slice(2,5);
console.log(markks);

//splice, select which element, then jitna tak remove karna hai uske bd agr koi aur element add karna ho toh uski jgh
